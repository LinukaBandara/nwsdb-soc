digraph G { graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.25]; node [fontname="Arial", fontsize=9, color="black"]; edge [color="black", arrowsize=.65, fontsize=8]; Start [shape=circle,label="",width=.18,style=filled,fillcolor=black]; Submit [shape=box,style="rounded",label="Customer submits account, amount and channel"]; Valid [shape=diamond,label="Valid request\nand account access?"]; Reject [shape=box,style="rounded",label="Return 400 or 403"]; Pending [shape=box,style="rounded",label="Create pending payment"]; PayHere [shape=diamond,label="PayHere channel?"]; Direct [shape=box,style="rounded",label="Complete direct portal payment"]; Signed [shape=box,style="rounded",label="Create signed checkout form"]; Gateway [shape=box,style="rounded",label="Customer completes or cancels checkout"]; Notify [shape=box,style="rounded",label="Validate server notification\nand update payment status"]; End [shape=doublecircle,label="",width=.22]; Start -> Submit -> Valid; Valid -> Reject [label="No"]; Reject -> End; Valid -> Pending [label="Yes"]; Pending -> PayHere; PayHere -> Direct [label="No"]; Direct -> End; PayHere -> Signed [label="Yes"]; Signed -> Gateway -> Notify -> End; }