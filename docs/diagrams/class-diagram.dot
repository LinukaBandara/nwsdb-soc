digraph ClassDiagram {
    rankdir=TB;
    bgcolor="white";
    fontname="Helvetica";
    node [shape=record fontname="Helvetica" fontsize=9 style=filled fillcolor="#ffffff"];
    edge [fontname="Helvetica" fontsize=8];

    Payment [label="{Payment (entity)|+ Id : int\l+ AccountNumber : string\l+ Amount : decimal\l+ Channel : string\l+ Status : PaymentStatus\l+ CreatedAtUtc : DateTime\l+ ReferenceNumber : string\l}" fillcolor="#eefaf0"];

    PaymentStatus [label="{\<\<enum\>\>\nPaymentStatus|Pending\lCompleted\lFailed\l}" fillcolor="#f5f5f5"];

    CreatePaymentRequest [label="{\<\<record\>\>\nCreatePaymentRequest|+ AccountNumber : string\l+ Amount : decimal\l+ Channel : string\l}" fillcolor="#eaf1fb"];

    PaymentResponse [label="{\<\<record\>\>\nPaymentResponse|+ Id : int\l+ AccountNumber : string\l+ Amount : decimal\l+ Channel : string\l+ Status : string\l+ ReferenceNumber : string\l+ CreatedAtUtc : DateTime\l|+ FromEntity(p : Payment) : PaymentResponse\l}" fillcolor="#eaf1fb"];

    IPaymentService [label="{\<\<interface\>\>\nIPaymentService|+ CreatePaymentAsync(req) : Task\<Payment\>\l+ GetPaymentAsync(id) : Task\<Payment?\>\l+ GetPaymentsForAccountAsync(acc) : Task\<IReadOnlyList\<Payment\>\>\l+ UpdateStatusAsync(id, status) : Task\<Payment?\>\l}" fillcolor="#fff3bf"];

    PaymentServiceImpl [label="{PaymentService|- _db : PaymentDbContext\l- _logger : ILogger\l|+ CreatePaymentAsync(req) : Task\<Payment\>\l+ GetPaymentAsync(id) : Task\<Payment?\>\l+ GetPaymentsForAccountAsync(acc) : Task\<IReadOnlyList\<Payment\>\>\l+ UpdateStatusAsync(id, status) : Task\<Payment?\>\l}" fillcolor="#ffffff"];

    PaymentsController [label="{PaymentsController|- _paymentService : IPaymentService\l|+ CreatePayment(req) : ActionResult\l+ GetPayment(id) : ActionResult\l+ GetPaymentsForAccount(acc) : ActionResult\l+ UpdateStatus(id, status) : ActionResult\l}" fillcolor="#bcd2ee"];

    PaymentDbContext [label="{PaymentDbContext|+ Payments : DbSet\<Payment\>\l}" fillcolor="#e2e2e2"];

    PaymentsController -> IPaymentService [arrowhead=vee label="uses"];
    PaymentServiceImpl -> IPaymentService [arrowhead=empty style=dashed label="implements"];
    PaymentServiceImpl -> PaymentDbContext [arrowhead=vee label="uses"];
    PaymentDbContext -> Payment [arrowhead=diamond label="DbSet<>"];
    Payment -> PaymentStatus [arrowhead=vee label="has"];
    PaymentResponse -> Payment [arrowhead=open style=dotted label="maps from"];
    PaymentsController -> CreatePaymentRequest [arrowhead=open style=dotted label="accepts"];
    PaymentsController -> PaymentResponse [arrowhead=open style=dotted label="returns"];

    label="Figure — Class Diagram: Payment Service (Usage Service mirrors this structure)";
    fontsize=13; fontname="Helvetica-Bold"; labelloc=t;
}
