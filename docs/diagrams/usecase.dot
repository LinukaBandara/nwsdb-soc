digraph UseCase {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    node [fontname="Helvetica" fontsize=10];

    subgraph cluster_system {
        label="NWSDB SOC System";
        fontname="Helvetica-Bold"; fontsize=13; fontcolor="#1A3A6B";
        style="rounded,filled"; color="#eef2fb";

        UC1 [label="Make a Payment" shape=ellipse style=filled fillcolor="#eefaf0"];
        UC2 [label="View Payment\nHistory" shape=ellipse style=filled fillcolor="#eefaf0"];
        UC3 [label="Record Meter\nReading" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC4 [label="View Latest Usage\n& Estimated Bill" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC5 [label="View Usage\nHistory" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC6 [label="Validate Payment\nRequest" shape=ellipse style="filled,dashed" fillcolor="#f5f5f5"];
        UC7 [label="Calculate Tiered\nEstimated Bill" shape=ellipse style="filled,dashed" fillcolor="#f5f5f5"];
    }

    Customer [label="Customer" shape=box style="rounded,filled" fillcolor="#bcd2ee"];
    Partner [label="Third-Party\nPayment Application" shape=box style="rounded,filled" fillcolor="#f6c8b6"];
    Meter [label="Meter /\nField System" shape=box style="rounded,filled" fillcolor="#f6c8b6"];

    Customer -> UC1;
    Customer -> UC2;
    Customer -> UC4;
    Customer -> UC5;
    Partner -> UC1;
    Meter -> UC3;

    UC1 -> UC6 [style=dashed label="<<include>>" fontsize=8];
    UC4 -> UC7 [style=dashed label="<<include>>" fontsize=8];

    label="Figure — Use Case Diagram: NWSDB SOC System";
    fontsize=13; fontname="Helvetica-Bold"; labelloc=t;
}