digraph UseCase {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    node [fontname="Helvetica" fontsize=10];

    subgraph cluster_system {
        label="NWSDB SOC System";
        fontname="Helvetica-Bold"; fontsize=13; fontcolor="#1A3A6B";
        style=filled; color="#eef2fb";
        style="rounded,filled";

        UC1 [label="Make a Payment" shape=ellipse style=filled fillcolor="#eefaf0"];
        UC2 [label="View Payment\nHistory" shape=ellipse style=filled fillcolor="#eefaf0"];
        UC3 [label="Confirm Payment\nStatus (webhook)" shape=ellipse style=filled fillcolor="#eefaf0"];
        UC4 [label="Record Meter\nReading" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC5 [label="View Latest Usage\n& Estimated Bill" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC6 [label="View Usage\nHistory" shape=ellipse style=filled fillcolor="#eaf1fb"];
        UC7 [label="Validate Payment\nAmount" shape=ellipse style="filled,dashed" fillcolor="#f5f5f5"];
        UC8 [label="Calculate Tiered\nBill" shape=ellipse style="filled,dashed" fillcolor="#f5f5f5"];
    }

    Customer [label="Customer" shape=box style="rounded,filled" fillcolor="#bcd2ee"];
    Partner [label="Third-Party\nPartner" shape=box style="rounded,filled" fillcolor="#f6c8b6"];
    Meter [label="Smart Meter /\nField Device" shape=box style="rounded,filled" fillcolor="#f6c8b6"];

    Customer -> UC1; Customer -> UC2; Customer -> UC5; Customer -> UC6;
    Partner -> UC1; Partner -> UC3;
    Meter -> UC4;

    UC1 -> UC7 [style=dashed label="<<include>>" fontsize=8];
    UC5 -> UC8 [style=dashed label="<<include>>" fontsize=8];

    label="Figure — Use Case Diagram: NWSDB SOC System";
    fontsize=13; fontname="Helvetica-Bold"; labelloc=t;
}
