digraph G { graph [rankdir=LR, bgcolor="white", pad=.2, nodesep=.3, ranksep=.7]; node [fontname="Arial", fontsize=9, color="black"]; edge [color="black"]; Customer [shape=plaintext,label="Customer\n  o\n /|\\\n / \\"]; Staff [shape=plaintext,label="Staff or Admin\n  o\n /|\\\n / \\"]; Partner [shape=plaintext,label="Authorised Partner\n  o\n /|\\\n / \\"]; subgraph cluster_system { label="NWSDB SOC system"; color="black"; style="rounded"; Login [shape=ellipse,label="Register or log in"]; Usage [shape=ellipse,label="View usage and\nestimated bill"]; History [shape=ellipse,label="View payment history"]; Checkout [shape=ellipse,label="Create payment or\nPayHere checkout"]; Reading [shape=ellipse,label="Record meter reading"]; Status [shape=ellipse,label="Update payment status"]; Api [shape=ellipse,label="Consume documented\nREST API"]; } Customer -> Login; Customer -> Usage; Customer -> History; Customer -> Checkout; Staff -> Reading; Staff -> Status; Partner -> Api; }