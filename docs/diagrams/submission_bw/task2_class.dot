digraph G { graph [rankdir=TB, bgcolor="white", pad=.2, nodesep=.35]; node [shape=record, color="black", fontname="Arial", fontsize=8]; edge [color="black", arrowsize=.65]; PC [label="{PaymentsController|+ CreatePayment()\l+ CreatePayHereCheckout()\l+ GetPaymentsForAccount()\l+ PayHereNotify()\l}"]; IP [label="{IPaymentService interface|+ CreatePaymentAsync()\l+ CreatePendingPaymentAsync()\l+ GetPaymentsForAccountAsync()\l+ UpdateStatusAsync()\l}"]; PS [label="{PaymentService|+ CreatePaymentAsync()\l+ UpdateStatusByReferenceAsync()\l}"]; PDB [label="{PaymentDbContext|+ Payments\l}"]; P [label="{Payment|+ Id: int\l+ AccountNumber: string\l+ Amount: decimal\l+ Channel: string\l+ Status: PaymentStatus\l}"]; UC [label="{UsageController|+ RecordReading()\l+ GetLatest()\l+ GetHistory()\l}"]; IU [label="{IUsageService interface|+ RecordReadingAsync()\l+ GetLatestUsageAsync()\l}"]; US [label="{UsageService|+ CalculateBill()\l}"]; UDB [label="{UsageDbContext|+ Readings\l}"]; MR [label="{MeterReading|+ Id: int\l+ AccountNumber: string\l+ CubicMetres: double\l}"]; PC -> IP [label="uses"]; IP -> PS [style=dashed,label="implements"]; PS -> PDB [label="uses"]; PDB -> P [label="stores"]; UC -> IU [label="uses"]; IU -> US [style=dashed,label="implements"]; US -> UDB [label="uses"]; UDB -> MR [label="stores"]; }