digraph G { graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.35]; node [shape=box, style="rounded", color="black", fontname="Arial", fontsize=9]; edge [color="black", arrowsize=.65]; Dev [label="Developer pushes source"]; CI [label="CI pipeline\nrestore build test image build"]; Registry [label="Container registry"]; Ingress [label="TLS ingress or API gateway"]; subgraph cluster_k8s { label="Kubernetes namespace: nwsdb-prod"; color="black"; style="rounded"; Client [label="React client deployment\nreplicas: 2"]; Id [label="Identity deployment\nreplicas: 1 until shared store"]; Pay [label="Payment deployment\nreplicas: 1 until shared store"]; Use [label="Usage deployment\nreplicas: 1 until shared store"]; Services [label="ClusterIP services and\nhealth probes"]; } Db [shape=cylinder,label="Future managed persistent database"]; Dev -> CI -> Registry -> Ingress; Ingress -> Client; Ingress -> Id; Ingress -> Pay; Ingress -> Use; Client -> Services; Id -> Services; Pay -> Services; Use -> Services; Services -> Db [style=dashed,label="after persistence upgrade"]; }