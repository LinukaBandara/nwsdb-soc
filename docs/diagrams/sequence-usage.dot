digraph SequenceUsage {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    node [shape=box fontname="Helvetica" fontsize=10 style="rounded,filled" fillcolor="#ffffff"];
    edge [fontname="Helvetica" fontsize=9];

    Customer [label="Customer" fillcolor="#bcd2ee"];
    Client [label="React Client" fillcolor="#eaf1fb"];
    Controller [label="UsageController" fillcolor="#eaf1fb"];
    Service [label="IUsageService /\nUsageService" fillcolor="#fff3bf"];
    Db [label="UsageDbContext" fillcolor="#e2e2e2"];
    Data [label="MeterReading data" fillcolor="#eefaf0"];

    Customer -> Client [label="1. Open customer portal"];
    Client -> Controller [label="2. GET /api/v1/usage/{account}/latest"];
    Controller -> Service [label="3. GetLatestUsageAsync(account)"];
    Service -> Db [label="4. Query latest two readings"];
    Db -> Data [label="5. Read meter readings"];
    Data -> Db [label="6. Reading results"];
    Db -> Service [label="7. Results"];
    Service -> Service [label="8. Calculate consumption + estimated bill"];
    Service -> Controller [label="9. UsageResponse"];
    Controller -> Client [label="10. 200 OK + JSON"];
    Client -> Customer [label="11. Display usage + estimated bill"];

    label="Figure — Sequence Diagram: View Latest Usage";
    fontsize=13; fontname="Helvetica-Bold"; labelloc=t;
}