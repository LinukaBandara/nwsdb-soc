digraph G { graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.4]; node [shape=box, style="rounded", color="black", fontname="Arial", fontsize=10]; edge [color="black", arrowsize=.7]; Clients [label="React portal | Mobile app | Authorised partner"]; Gateway [label="REST API contracts over HTTPS"]; Identity [label="Identity Service\nJWT and roles"]; Payment [label="Payment Service\nPayments and PayHere checkout"]; Usage [label="Usage Service\nReadings and estimated bill"]; Idb [shape=cylinder,label="Identity store"]; Pdb [shape=cylinder,label="Payment store"]; Udb [shape=cylinder,label="Usage store"]; Clients -> Gateway; Gateway -> Identity; Gateway -> Payment; Gateway -> Usage; Identity -> Idb; Payment -> Pdb; Usage -> Udb; }