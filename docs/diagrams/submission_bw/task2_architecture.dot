digraph G { graph [rankdir=LR, bgcolor="white", pad=.2, nodesep=.45, ranksep=.65]; node [shape=box, style="rounded", color="black", fontname="Arial", fontsize=9]; edge [color="black", arrowsize=.65, fontname="Arial", fontsize=8]; Client [label="React client\nPresentation layer"]; Auth [label="Identity Service\n/api/v1/auth\nJWT authentication"]; Pay [label="Payment Service\n/api/v1/payments\nAuthorisation and checkout"]; Use [label="Usage Service\n/api/v1/usage\nReadings and tariff"]; PH [label="PayHere Sandbox\nExternal payment gateway"]; AuthDb [shape=cylinder,label="Identity data"]; PayDb [shape=cylinder,label="Payment data"]; UseDb [shape=cylinder,label="Usage data"]; Client -> Auth [label="register login"]; Client -> Pay [label="Bearer JWT"]; Client -> Use [label="Bearer JWT"]; Pay -> PH [label="signed checkout"]; Auth -> AuthDb; Pay -> PayDb; Use -> UseDb; }